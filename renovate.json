{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":gitSignOff",
    ":dependencyDashboard",
    ":label(dependencies)",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlertsWithAdditionalLabel(kind/security)",
    ":automergeMinor",
    ":automergeDigest",
    ":automergeLinters",
    ":automergeTesters",
    ":prConcurrentLimit20",
    "helpers:pinGitHubActionDigests",
    "security:openssf-scorecard",
    "group:linters"
  ],
  "ignorePaths": [
    "**/tmp/**",
    ".github/workflows/smyklot-pr-commands.yml",
    ".github/workflows/smyklot-poll.yml"
  ],
  "osvVulnerabilityAlerts": true,
  "gitIgnoredAuthors": ["205507218+smyklot[bot]@users.noreply.github.com"],
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "addLabels": ["area/ci"],
      "commitMessageTopic": "{{depName}} action",
      "description": "GitHub Actions dependencies",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Group SvelteKit ecosystem dependencies",
      "groupName": "SvelteKit",
      "matchPackageNames": [
        "@sveltejs/**",
        "svelte",
        "svelte-check"
      ]
    },
    {
      "description": "Group shadcn-svelte and bits-ui dependencies",
      "groupName": "shadcn-svelte",
      "matchPackageNames": [
        "bits-ui",
        "tailwind-variants",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
      "description": "Group testing dependencies",
      "groupName": "testing",
      "matchPackageNames": [
        "vitest",
        "@testing-library/**",
        "@playwright/test",
        "jsdom"
      ]
    },
    {
      "description": "Group Tailwind CSS dependencies",
      "groupName": "Tailwind CSS",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**"
      ]
    },
    {
      "description": "Smyklot action managed by sync-smyklot workflow",
      "enabled": false,
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["smykla-skalski/smyklot"]
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true
  }
}
